{
	"name": "aaron-gustafson.com",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:5-26-trixie",
	"remoteUser": "node",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {
			"autoPull": false
		}
	},
	"postCreateCommand": "git lfs install --local",
	"forwardPorts": [8080, 8888],
	"portsAttributes": {
		"8080": {
			"label": "Eleventy",
			"onAutoForward": "notify"
		},
		"8888": {
			"label": "Static preview / Netlify Dev",
			"onAutoForward": "notify"
		}
	},
	"customizations": {
		"vscode": {
			"settings": {
				"remote.localPortHost": "localhost"
			}
		}
	}
}
